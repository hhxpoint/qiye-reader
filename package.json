{
  "name": "qiye-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first literature reading workspace with browser translation and source-page-preserving PDF/Word export.",
  "license": "MIT",
  "homepage": "https://qiye-library-q5ridqj4azi.qoder.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/hhxpoint/qiye-reader.git"
  },
  "bugs": {
    "url": "https://github.com/hhxpoint/qiye-reader/issues"
  },
  "keywords": [
    "literature-review",
    "pdf",
    "translation",
    "local-first",
    "react",
    "typescript",
    "qoder"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "predev": "node scripts/with-node.mjs scripts/check-node.mjs",
    "prebuild": "node scripts/with-node.mjs scripts/check-node.mjs",
    "dev": "node scripts/with-node.mjs node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node scripts/with-node.mjs node_modules/typescript/bin/tsc --noEmit && node scripts/with-node.mjs scripts/build.mjs",
    "preview": "node scripts/with-node.mjs node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node scripts/with-node.mjs tests/run.mjs",
    "dev:function": "deno run --allow-net=127.0.0.1:8000 dev/function-local.ts",
    "check:function": "deno check functions/index.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@huggingface/transformers": "4.3.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "docx": "9.16.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "node": "24.22.3",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "type": "module",
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.0.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.1"
  }
}
